# Machine-specific values used by the scripts in this repo. Copy to scripts/local.env
# (gitignored) and fill in the real values for your machine; scripts/local.env is sourced
# by every script that needs one of these, and a script stops with an error if a value it
# requires is missing here.
LI_MODELS_DIR=            # directory holding the model GGUF files
LI_LLAMA_CPP_DIR=         # the pinned llama.cpp checkout the oracle builds against (docs/upstreams.toml)
LI_BUILD_HOST=            # name of the machine that builds and runs production (informational)
LI_VERUS_HOST=            # name of the machine where the Verus proofs are run (informational)
LI_GATEWAY_URL=           # base URL of the gateway that fronts production, e.g. http://127.0.0.1:<gateway port>
LI_ORIGIN_PORT=           # port the production llama-server itself answers on (behind the gateway)
LI_BENCH_PORT=            # free port for a private llama-server / infr serve during a GPU window
LI_GPU_LEASE=             # path to the GPU lease tool
LI_GPU_FLOCK=             # flock file of the coding-agent queue lock
LI_PROD_UNIT=             # systemd --user unit name of the production server
LI_API_KEY_FILE=          # file holding the API key of the production server
